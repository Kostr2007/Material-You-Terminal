# Material You colors for fish — generated by material-you-terminal ({{mode}})

set -g fish_color_normal         {{on_surface.strip}}
set -g fish_color_command        {{primary.strip}} --bold
set -g fish_color_keyword        {{tertiary.strip}} --bold
set -g fish_color_param          {{on_surface.strip}}
set -g fish_color_option         {{secondary.strip}}
set -g fish_color_quote          {{ansi2.strip}}
set -g fish_color_redirection    {{tertiary.strip}}
set -g fish_color_end            {{secondary.strip}}
set -g fish_color_operator       {{tertiary.strip}}
set -g fish_color_escape         {{ansi6.strip}}
set -g fish_color_error          {{error.strip}} --bold
set -g fish_color_comment        {{outline.strip}} --italics
set -g fish_color_autosuggestion {{outline.strip}}
set -g fish_color_valid_path     --underline=curly
set -g fish_color_cwd            {{primary.strip}}
set -g fish_color_cwd_root       {{error.strip}}
set -g fish_color_user           {{tertiary.strip}}
set -g fish_color_host           {{secondary.strip}}
set -g fish_color_host_remote    {{tertiary.strip}}
set -g fish_color_status         {{error.strip}}
set -g fish_color_cancel         {{error.strip}} --reverse
set -g fish_color_history_current --bold
set -g fish_color_match          --background={{secondary_container.strip}}
set -g fish_color_search_match   {{on_secondary_container.strip}} --background={{secondary_container.strip}}
set -g fish_color_selection      {{on_primary_container.strip}} --bold --background={{primary_container.strip}}

set -g fish_pager_color_progress             {{on_tertiary_container.strip}} --background={{tertiary_container.strip}}
set -g fish_pager_color_prefix               {{primary.strip}} --bold
set -g fish_pager_color_completion           {{on_surface.strip}}
set -g fish_pager_color_description          {{outline.strip}} --italics
set -g fish_pager_color_selected_background  --background={{secondary_container.strip}}
set -g fish_pager_color_selected_prefix      {{on_secondary_container.strip}} --bold
set -g fish_pager_color_selected_completion  {{on_secondary_container.strip}}
set -g fish_pager_color_selected_description {{on_secondary_container.strip}}

# exported for scripts and prompts that want the palette
set -gx MYT_MODE {{mode}}
set -gx MYT_PRIMARY {{primary}}
set -gx MYT_ON_PRIMARY {{on_primary}}
set -gx MYT_SECONDARY {{secondary}}
set -gx MYT_TERTIARY {{tertiary}}
set -gx MYT_SURFACE {{surface}}
set -gx MYT_ON_SURFACE {{on_surface}}
set -gx MYT_OUTLINE {{outline}}
set -gx MYT_ERROR {{error}}
